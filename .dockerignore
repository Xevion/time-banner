### Rust template
# Generated by Cargo
# will have compiled files and executables
debug/
target/

# These are backup files generated by rustfmt
**/*.rs.bk

.idea/

# Fetched inside the build (see Dockerfile); excluding it here keeps the
# later full-source COPY from clobbering what the earlier xtask run wrote.
crates/render/fonts/*.ttf
crates/core/geoip/geoip.bin