/target
.idea
.env
*.env.local
*.log
.DS_Store
.vscode/
.bacon-locations

# Fetched by `just fonts` (cargo xtask fonts); not committed.
/crates/render/fonts/*.ttf

# Generated by `just geoip` (cargo xtask geoip) from a licensed DB-IP
# download; not committed, and not required to build (memory-mapped at
# runtime, not compiled in).
/crates/core/geoip/geoip.bin

# Subsetted faces built by `just fonts` from the fetched upstream ones.
/crates/render/fonts/bundle/*.ttf
